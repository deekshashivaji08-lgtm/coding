import java.util.LinkedList;
import java.util.Scanner;
class LinkedListOperations {

    // Insert elements at front
    public static void insertAtFront(LinkedList<Integer> list, String[] inputs, int n) {

        for (int i = 0; i < n; i++) {
            int num = Integer.parseInt(inputs[i]);
            list.addFirst(num);
        }
    }
    public static void printList(LinkedList<Integer> list) {

        for (int val : list) {
            System.out.print(val + " ");
        }

        System.out.println();
    }
    public static int printMiddle(LinkedList<Integer> list) {

        int n = list.size();
        int middleIndex = n / 2;

        return list.get(middleIndex);
    }
}


public class Main {

    public static void main(String[] args) {

        Scanner scanner = new Scanner(System.in);

        LinkedList<Integer> list = new LinkedList<>();

        int n = scanner.nextInt();
        scanner.nextLine();

        String[] inputs = scanner.nextLine().split(" ");

        LinkedListOperations.insertAtFront(list, inputs, n);

        LinkedListOperations.printList(list);

        int middle_element = LinkedListOperations.printMiddle(list);

        System.out.println("Middle Element: " + middle_element);

        scanner.close();
    }
}
