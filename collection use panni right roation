import java.util.*;
public class Main {
    static void customRotate(ArrayList<Integer> list, int k) {
        int n = list.size();
        k = k % n;
        ArrayList<Integer> result = new ArrayList<>();
        for (int i = n - k; i < n; i++) {
            result.add(list.get(i));
        }
        for (int i = n - k - 1; i >= 0; i--) {
            result.add(list.get(i));
        }
        for (int num : result) {
            System.out.print(num + " ");
        }
    }
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        ArrayList<Integer> list = new ArrayList<>();
        int n=sc.nextInt();
        for (int i = 0; i < n; i++) {
            list.add(sc.nextInt());
        }
        int k = sc.nextInt();
        customRotate(list, k); 
        sc.close();
    }
}
