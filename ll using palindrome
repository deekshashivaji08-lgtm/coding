import java.util.*;
class node {
    int data;
    node addr;
    node(int val) {
        data = val;
        addr = null;
    }
}
class Linkedlist {
    node head = null;
    void insertAtEnd(int val) {
        node newnode = new node(val);
        if (head == null) {
            head = newnode;
        } else {
            node temp = head;
            while (temp.addr != null) {
                temp = temp.addr;
            }
            temp.addr = newnode;
        }
    }
    boolean isPalindrome() {
        if (head == null || head.addr == null) {
            return true;
        }
        node slow = head;
        node fast = head;
        while (fast != null && fast.addr != null) {
            slow = slow.addr;
            fast = fast.addr.addr;
        }
        node prev = null;
        node curr = slow;
        node next;
        while (curr != null) {
            next = curr.addr;
            curr.addr = prev;
            prev = curr;
            curr = next;
        }
        node first = head;
        node second = prev;
        while (second != null) {
            if (first.data != second.data) {
                return false;
            }
            first = first.addr;
            second = second.addr;
        }
        return true;
    }
}
public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        Linkedlist ll = new Linkedlist();
        int n = sc.nextInt();

        for (int i = 0; i < n; i++) {
            int val = sc.nextInt();
            ll.insertAtEnd(val);
        }
        if (ll.isPalindrome()) {
            System.out.println("Palindrome");
        } else {
            System.out.println("Not Palindrome");
        }
    }
}
